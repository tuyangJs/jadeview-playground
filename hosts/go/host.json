{
  "id": "go",
  "language": "Go",
  "displayName": "Go + JadeViewGo v3",
  "version": "0.2.0",
  "entry": "hosts/go/main.go",
  "requirements": [
    "Go 1.23+",
    "Node.js 22+（构建及热更新）",
    "JadeViewGo v3（版本见 go.mod，原生 ABI 0x00030003）"
  ],
  "devCommand": "go -C hosts/go run . --dev",
  "runCommand": "go -C hosts/go run .",
  "frontendArg": "--frontend <path>",
  "devArg": "--dev [url]",
  "capabilities": [
    "window",
    "layout",
    "ipc",
    "events",
    "dialogs",
    "tray",
    "clipboard",
    "storage",
    "runtime",
    "menus",
    "resources",
    "permissions",
    "splash",
    "webpopup"
  ],
  "supportedExamples": [
    "dwm",
    "overlay",
    "hidden",
    "frameless",
    "theme",
    "flags",
    "layout",
    "bounds",
    "navscript",
    "empty",
    "ipc",
    "messages",
    "events",
    "dialogs",
    "tray",
    "clipboard",
    "storage",
    "runtime",
    "profiles",
    "menubar",
    "contextmenu",
    "resources",
    "permissions",
    "splash",
    "webpopup"
  ],
  "unsupportedExamples": {},
  "frontendModule": "web/src/hosts/languages/go.ts",
  "repository": "https://github.com/tuyangJs/jadeview-playground"
}
